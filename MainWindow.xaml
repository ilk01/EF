<Window x:Class="WpfTcpClientServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TCP Client" Height="250" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#2E2E2E" Foreground="White">
    <Grid>
        <TextBox Name="MessageTextBox" Width="300" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,10,0"
                 Background="#555" Foreground="White" FontSize="14" KeyDown="MessageTextBox_KeyDown" />

        <Button Name="SendButton" Content="Отправить" Width="80" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="320,10,10,0" 
                Background="#444" Foreground="White" Click="SendButton_Click" />

        <TextBlock Name="ResponseTextBox" Width="300" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,60,10,0"
                   Background="#444" Foreground="White" FontSize="14" TextWrapping="Wrap" />
    </Grid>
</Window>